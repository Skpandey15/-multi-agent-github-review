# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Gmail SMTP (use App Password, not your real password)
# Generate at: myaccount.google.com → Security → 2-Step → App Passwords
GMAIL_USERNAME=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email recipient
APP_EMAIL_TO=recipient@email.com

# Database (used inside docker-compose — do not change)
DB_HOST=postgres
DB_NAME=github_review
DB_USER=postgres
DB_PASSWORD=postgres

# Temporal (used inside docker-compose — do not change)
TEMPORAL_HOST=temporal

# Scheduler (off by default — set true + SCHEDULER_REPOS to enable cron)
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 0 2 * * *
SCHEDULER_BRANCH=main
SCHEDULER_REPOS=
